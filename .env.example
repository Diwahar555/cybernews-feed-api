# PostgreSQL used by Docker Compose
POSTGRES_DB=cybernews
POSTGRES_USER=cybernews
POSTGRES_PASSWORD=change-me

# Backend
APP_ENV=development
APP_DEBUG=false
DOCS_ENABLED=true
DATABASE_URL=postgresql+asyncpg://cybernews:change-me@db:5432/cybernews
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
TRUSTED_HOSTS=localhost,127.0.0.1,api
INGESTION_INTERVAL_MINUTES=180
INGESTION_HTTP_TIMEOUT_SECONDS=20
INGESTION_MAX_ENTRIES_PER_SOURCE=50
INGESTION_USER_AGENT=CyberNewsFeed/1.0 (portfolio RSS aggregator)
LOG_LEVEL=INFO
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
